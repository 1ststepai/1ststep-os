{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://1ststep.ai/os/schemas/0.1.0/finding.schema.json",
  "title": "Finding",
  "description": "Audit finding with an immutable ID. Findings are never deleted; they change status with evidence.",
  "type": "object",
  "required": ["kind", "schemaVersion", "id", "title", "severity", "domain", "category", "createdAt", "evidence", "impact", "remediation", "status"],
  "additionalProperties": false,
  "properties": {
    "kind": { "const": "Finding" },
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "id": { "type": "string", "pattern": "^F-[0-9]{4,}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "severity": { "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"] },
    "domain": { "$ref": "common.schema.json#/$defs/domain" },
    "category": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}$" },
    "source": { "type": "string", "maxLength": 300 },
    "createdAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "affectedFiles": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/relativePath" } },
    "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/evidenceItem" } },
    "impact": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "remediation": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "status": { "enum": ["OPEN", "IN_PROGRESS", "FIXED_UNVERIFIED", "VERIFIED", "ACCEPTED_RISK", "WONT_FIX", "DUPLICATE"] },
    "verification": {
      "type": "object",
      "required": ["method", "result", "at", "by"],
      "properties": {
        "method": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "result": { "enum": ["PASS", "FAIL"] },
        "at": { "$ref": "common.schema.json#/$defs/timestamp" },
        "by": { "$ref": "common.schema.json#/$defs/actor" },
        "ref": { "type": "string", "maxLength": 1000 }
      },
      "additionalProperties": false
    },
    "duplicateOf": { "type": "string", "pattern": "^F-[0-9]{4,}$" },
    "riskAcceptance": {
      "type": "object",
      "required": ["acceptedBy", "at", "rationale"],
      "properties": {
        "acceptedBy": { "$ref": "common.schema.json#/$defs/userActor" },
        "at": { "$ref": "common.schema.json#/$defs/timestamp" },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 2000 }
      },
      "additionalProperties": false
    },
    "relatedFindingIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^F-[0-9]{4,}$" } }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "VERIFIED" } } },
      "then": { "required": ["verification"], "properties": { "verification": { "properties": { "result": { "const": "PASS" } } } } }
    },
    { "if": { "properties": { "status": { "const": "DUPLICATE" } } }, "then": { "required": ["duplicateOf"] } },
    { "if": { "properties": { "status": { "enum": ["ACCEPTED_RISK", "WONT_FIX"] } } }, "then": { "required": ["riskAcceptance"] } }
  ]
}
