{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://1ststep.ai/os/schemas/0.1.0/module-registry.schema.json",
  "title": "ModuleRegistry",
  "type": "object",
  "required": ["kind", "schemaVersion", "registryVersion", "modules"],
  "additionalProperties": false,
  "properties": {
    "kind": { "const": "ModuleRegistry" },
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "registryVersion": { "$ref": "common.schema.json#/$defs/semver" },
    "modules": { "type": "array", "minItems": 1, "items": { "$ref": "module-definition.schema.json" } }
  }
}
