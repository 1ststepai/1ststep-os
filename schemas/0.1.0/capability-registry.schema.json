{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://1ststep.ai/os/schemas/0.1.0/capability-registry.schema.json",
  "title": "CapabilityRegistry",
  "type": "object",
  "required": ["kind", "schemaVersion", "registryVersion", "generatedBy", "capabilities"],
  "additionalProperties": false,
  "properties": {
    "kind": { "const": "CapabilityRegistry" },
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "registryVersion": { "$ref": "common.schema.json#/$defs/semver" },
    "generatedBy": { "$ref": "common.schema.json#/$defs/relativePath" },
    "capabilities": { "type": "array", "minItems": 1, "items": { "$ref": "capability-definition.schema.json" } }
  }
}
